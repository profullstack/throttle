{
  "name": "@profullstack/throttle",
  "version": "0.2.3",
  "type": "module",
  "description": "An app-wide rate limit whose answer to going over is a price, not a 429. 100 requests a minute free, then x402 Payment Required with an offer, settled by CoinPay. Meters every route, so a scraper wearing a browser user agent is charged like any other crawler.",
  "keywords": [
    "rate-limit",
    "throttle",
    "x402",
    "402",
    "payment-required",
    "scraping",
    "anti-scraping",
    "crawler",
    "nextjs",
    "hono",
    "middleware",
    "coinpay",
    "usdc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profullstack/throttle.git"
  },
  "homepage": "https://github.com/profullstack/throttle#readme",
  "bugs": {
    "url": "https://github.com/profullstack/throttle/issues"
  },
  "license": "MIT",
  "author": "Profullstack, LLC",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js"
    },
    "./next": {
      "types": "./index.d.ts",
      "import": "./src/next.js"
    },
    "./hono": {
      "types": "./index.d.ts",
      "import": "./src/hono.js"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "sideEffects": false,
  "dependencies": {
    "@profullstack/x402-gateway": "^0.6.0 || ^0.7.0"
  },
  "scripts": {
    "test": "node --test"
  }
}
